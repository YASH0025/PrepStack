# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the app (used for links in emails).
APP_URL=http://localhost:3000

# Folder for JSON data files. Must be on a persistent disk. Git-ignored.
DATA_DIR=./data

# Storage: "json" (files under DATA_DIR, single process) or "postgres".
# Postgres mode also switches sign-in to Better Auth (database sessions, Google/GitHub).
STORAGE_DRIVER=json
# Required for postgres, e.g. postgres://user:password@host:5432/prepstack (Neon works too).
DATABASE_URL=
# Optional direct (non-pooled) connection for migrations, e.g. Neon's direct URL on Vercel.
DATABASE_URL_UNPOOLED=

# --- Required secrets ---------------------------------------------------------
# Generate each with:  openssl rand -base64 32

# Signs session cookies. At least 32 characters.
SESSION_SECRET=

# AES-256-GCM key for sensitive fields. Exactly 32 bytes, base64-encoded.
# Losing this key makes encrypted fields unreadable. Back it up.
ENCRYPTION_KEY=

# Protects POST /api/cron/run. At least 16 characters.
CRON_SECRET=

# --- Optional -------------------------------------------------------------------

# Comma-separated emails that become admins when they sign up.
ADMIN_EMAILS=

# Resend (https://resend.com). If empty, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="PrepStack <onboarding@resend.dev>"

# Cloudinary (https://cloudinary.com). Set all three or none. If empty, uploads are disabled.
# For PDF attachments, enable "Allow delivery of PDF and ZIP files" in Cloudinary security settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google / GitHub sign-in (postgres mode only). Set both values of a pair to enable it.
# Callback URLs: {APP_URL}/api/auth/callback/google and {APP_URL}/api/auth/callback/github
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ScaleLab, used for system design practice links.
SCALELAB_URL=https://scale-lab-pi.vercel.app

# Minimum number of community reports before topic frequencies are shown or used.
COMMUNITY_MIN_SAMPLE=5
