# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the app (used for links in emails).
APP_URL=http://localhost:3000

# Folder for JSON data files. Must be on a persistent disk. Git-ignored.
DATA_DIR=./data

# --- Required secrets ---------------------------------------------------------
# Generate each with:  openssl rand -base64 32

# Signs session cookies. At least 32 characters.
SESSION_SECRET=

# AES-256-GCM key for sensitive fields. Exactly 32 bytes, base64-encoded.
# Losing this key makes encrypted fields unreadable. Back it up.
ENCRYPTION_KEY=

# Protects POST /api/cron/run. At least 16 characters.
CRON_SECRET=

# --- Optional -------------------------------------------------------------------

# Comma-separated emails that become admins when they sign up.
ADMIN_EMAILS=

# Resend (https://resend.com). If empty, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="PrepStack <onboarding@resend.dev>"

# Cloudinary (https://cloudinary.com). Set all three or none. If empty, uploads are disabled.
# For PDF attachments, enable "Allow delivery of PDF and ZIP files" in Cloudinary security settings.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Minimum number of community reports before topic frequencies are shown or used.
COMMUNITY_MIN_SAMPLE=5
